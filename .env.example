# Copia este archivo a ".env" (NO lo subas al git) y rellena con los
# valores reales antes de "docker compose up -d".

# Dominio base del multisitio, SIN protocolo y SIN subdominio.
# Es el dominio que se usará como "raíz" de la red (ej. prototipos.tudominio.com)
WORDPRESS_DOMAIN=prototipos.tudominio.com

# Credenciales contra la base de datos compartida (contenedor mysql_db / alias "db").
# Esta BD y este usuario hay que crearlos antes en ese contenedor (ver README paso 2).
WORDPRESS_DB_USER=wp_multisite_user
WORDPRESS_DB_PASSWORD=cambia-esto-por-una-clave-fuerte
WORDPRESS_DB_NAME=wp_multisite
